#!/usr/bin/env bash
# dctl - the Debux tool interface. The implementation is deliberately private:
# users need neither mise activation nor project configuration.
set -euo pipefail

show_help() {
  case "${1:-}" in
    install)
      printf '%s\n' 'Usage: dctl install <pkg> [pkg...]' '' \
        'Install a tool or reuse its saved pinned version.' \
        'Use name@version to select a version; name@latest explicitly upgrades.' \
        'Examples: dctl install yq redis postgresql' \
        '          dctl install ggshield@1.54.0'
      ;;
    remove)
      printf '%s\n' 'Usage: dctl remove <pkg> [pkg...]' '' \
        'Remove user-installed tools. Preinstalled image tools remain available.'
      ;;
    search)
      printf '%s\n' 'Usage: dctl search <query>' '' 'Search available tool names/backends.'
      ;;
    list)
      printf '%s\n' 'Usage: dctl list' '' 'List preinstalled and user-installed tools.'
      ;;
    update)
      printf '%s\n' 'Usage: dctl update' '' \
        'Refresh tool metadata without upgrading installed versions.' \
        'Use dctl install <pkg>@latest to upgrade a tool.'
      ;;
    "")
      printf '%s\n' 'dctl - debux package manager' '' \
        'Usage:' \
        '  dctl install <pkg> [pkg...]   Install/reuse tools (name@version; @latest to upgrade)' \
        '  dctl remove <pkg> [pkg...]    Remove user-installed tools' \
        '  dctl search <query>           Search available tools' \
        '  dctl list                     List base and user-installed tools' \
        '  dctl update                   Refresh tool metadata' \
        '  dctl help [command]           Show help (also COMMAND --help)'
      ;;
    *) echo "Unknown dctl command: $1 (see dctl help)" >&2; return 2;;
  esac
}

# Help must work without a writable HOME/store or even an installed backend.
case "${1:-}" in
  ""|--help|-h) show_help; exit 0;;
  help)
    if [[ $# -gt 2 ]]; then echo 'Usage: dctl help [command]' >&2; exit 2; fi
    show_help "${2:-}"
    exit 0
    ;;
  install|remove|search|list|update)
    for arg in "$@"; do
      if [[ "$arg" == --help || "$arg" == -h ]]; then show_help "$1"; exit 0; fi
    done
    ;;
  *) show_help "$1"; exit 2;;
esac

cd /
# shellcheck source=images/debug/environment.sh
source /etc/debux/environment.sh
# Installers must not inherit the lock (a spawned daemon could hold it forever).
mise() { /usr/local/bin/mise "$@" 9>&-; }

if [[ -z "${HOME:-}" || ! -d "$HOME" || ! -w "$HOME" || ! -O "$HOME" ]]; then
  HOME="/tmp/debux-home-$(id -u)"
  export HOME
  mkdir -p "$HOME"
fi

resolve_pkg() {
  local pkg="$1" version=""
  if [[ ! "$pkg" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+/@:-]*$ ]]; then
    echo "Invalid tool '$pkg'. Use a tool name, optionally name@version." >&2
    return 2
  fi
  if [[ "$pkg" == *@* ]]; then
    version="@${pkg##*@}"
    pkg="${pkg%@*}"
  fi
  case "$pkg" in
    python3) pkg=python;;
    nodejs|npm|npx) pkg=node;;
    nvim) pkg=neovim;;
    rg) pkg=ripgrep;;
    ag|silver-searcher) pkg=the_silver_searcher;;
    http|https|httpie) pkg=pipx:httpie;;
    # Aqua's ggshield binaries don't support Linux ARM64. Version overrides
    # consistently use the upstream Python package on both architectures.
    ggshield) pkg=pipx:ggshield;;
    cargo|rustc) pkg=rust;;
    postgresql|psql|pg_dump|pg_restore|pg_dumpall|pg_isready|pg_ctl|initdb) pkg=postgres;;
    redis-cli|redis-server|redis-benchmark|redis-sentinel) pkg=redis;;
    cc|c++|g++) pkg=gcc;;
    make|gnumake) pkg='make';;
    ip|ss) pkg=iproute2;;
    netstat|ifconfig|nettools) pkg=net-tools;;
    ping) pkg=iputils;;
    nc|ncat) pkg=nmap;;
    pgrep|pkill|free|watch) pkg=procps;;
    xargs) pkg=findutils;;
    awk) pkg=gawk;;
    gnused) pkg='sed';;
    gnugrep) pkg='grep';;
    diff) pkg=diffutils;;
    tar|gnutar) pkg=libarchive-tools;;
  esac
  printf '%s%s\n' "$pkg" "$version"
}

ensure_writable() {
  if [[ ! -w "$DEBUX_DATA_DIR" || ! -w "$MISE_DATA_DIR" ]]; then
    echo "The Debux tool store is not writable by UID $(id -u). Start a fresh session with the current image." >&2
    return 1
  fi
  # Serialize changes across shells sharing this store. Never chmod a foreign
  # store or change privileges to make an installation succeed.
  exec 9>"$DEBUX_DATA_DIR/.dctl.lock"
  flock -x 9
}

refresh_commands() {
  local commands new old name
  commands="$(mise bin-paths --bin-names)" || return
  new="$(mktemp -d "$DEBUX_DATA_DIR/.bin.XXXXXXXX")" || return
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    if [[ ! "$name" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.+-]*$ ]]; then
      echo "Refusing unsafe executable name: $name" >&2
      rm -rf -- "$new"
      return 1
    fi
    ln -sf /usr/local/libexec/debux-tool "$new/$name" || { rm -rf -- "$new"; return 1; }
  done <<< "$commands"
  old="$(readlink "$DEBUX_TOOL_BIN")" || { rm -rf -- "$new"; return 1; }
  # All files are ready before publishing; running shells never see half of
  # the next command set. bin is a symlink in the image's initial empty store.
  if ! { rm -f "$DEBUX_DATA_DIR/.bin-next" &&
    ln -s "$new" "$DEBUX_DATA_DIR/.bin-next" &&
    mv -Tf "$DEBUX_DATA_DIR/.bin-next" "$DEBUX_TOOL_BIN"; }; then
    rm -rf -- "$new"
    return 1
  fi
  case "$old" in
    "$DEBUX_DATA_DIR"/.bin.*) rm -rf -- "$old";;
  esac
}

case "${1:-}" in
  install)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: dctl install <pkg> [pkg...]" >&2
      exit 2
    fi
    ensure_writable
    status=0
    for pkg in "$@"; do
      resolved="$(resolve_pkg "$pkg")" || { status=1; continue; }
      if [[ "$resolved" != *@* ]]; then
        # --tools may run again in a fresh container sharing this volume. Reuse
        # its pinned installation without resolving latest or rebuilding it.
        # --installed excludes incomplete/removed installations so they retry.
        # Don't resolve a registry backend just to check an APK-only package
        # such as gcc. Use the installed inventory and the baked jq, not a user
        # override that would recursively dispatch through mise.
        saved="$(mise ls --global --current --installed --json | /usr/bin/jq -er --arg tool "$resolved" \
          'if type != "object" then error("Invalid installed-tool inventory") else (.[$tool] // [] | length) end')" || { status=1; continue; }
        if [[ "$saved" -gt 0 ]]; then
          echo "$resolved is already installed in the saved tool store."
          continue
        fi
        baked="$resolved"
        # Bare ggshield uses the baked APK; an explicit pipx:ggshield request
        # still installs a user override. Removal resolves to that same backend.
        if [[ "$pkg" == ggshield ]]; then baked=ggshield; fi
        if apk info -e -- "$baked" >/dev/null 2>&1; then
          echo "$baked is already provided by the image."
          continue
        fi
      fi
      # Python CLIs use a pinned user-space helper only when needed. Keeping
      # uv out of the base saves ~47 MB without asking users to configure pipx.
      if [[ "$resolved" == pipx:* ]] && ! command -v uv >/dev/null 2>&1; then
        echo "Installing Python-tool support (uv)..."
        mise use --global --pin uv@0.12.10 || { status=1; continue; }
        refresh_commands || { status=1; continue; }
      fi
      echo "Installing $resolved..."
      # Installed dependency binaries (e.g. uv) must be on the installer's PATH,
      # not reached recursively through our dispatch links.
      # Installing PostgreSQL should install tools, not initialize a database
      # (and initdb intentionally refuses root). Users can run initdb explicitly.
      if POSTGRES_SKIP_INITDB=1 mise exec -- /usr/local/bin/mise use --global --pin -- "$resolved"; then
        echo "Installed $resolved."
      else
        status=1
        echo "Could not install '$resolved'. Try: dctl search $pkg" >&2
        echo "Not every OS package is a mise tool; system packages may require a custom image. System dependencies are not installed automatically." >&2
      fi
    done
    refresh_commands || status=1
    exit "$status"
    ;;
  remove)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: dctl remove <pkg> [pkg...]" >&2
      exit 2
    fi
    ensure_writable
    status=0
    for pkg in "$@"; do
      resolved="$(resolve_pkg "$pkg")" || { status=1; continue; }
      name="${resolved%@*}"
      # Only touch tools in the user profile, never baked OS packages.
      installed="$(mise ls --global --current -- "$name")" || { status=1; continue; }
      if [[ -z "$installed" ]]; then
        echo "Package '$name' not found in user profile (base tools cannot be removed)."
        continue
      fi
      if mise use --global --remove "$name" && mise uninstall -- "$name"; then
        echo "Removed $name."
      else
        status=1
      fi
    done
    refresh_commands || status=1
    exit "$status"
    ;;
  search)
    shift
    if [[ $# -ne 1 || -z "$1" ]]; then
      echo "Usage: dctl search <query>" >&2
      exit 2
    fi
    registry="$(mise registry)"
    query="$(resolve_pkg "$1" 2>/dev/null)" || query="$1"
    if [[ "$query" == pipx:* ]]; then
      echo "$query — Python package backend (dctl install $query)"
    elif ! grep -iF -- "${query%@*}" <<< "$registry"; then
      echo "No registry shorthand matched '$1'. OS packages are not all available through mise."
    fi
    ;;
  list)
    echo "Base packages (from image):"
    cat /usr/share/debux/base-packages.txt
    echo
    echo "User-installed packages:"
    mise ls --global --current
    ;;
  update)
    ensure_writable
    mise cache clear
    echo "Refreshed tool metadata. Installed versions stay pinned; use dctl install <pkg>@latest to update a tool."
    ;;
  *) echo "Unknown dctl command: $1 (see dctl help)" >&2; exit 2;;
esac

#!/usr/bin/env bash
# dctl - debux package manager
set -euo pipefail
cd /

# Ensure nix experimental features are available regardless of /etc/nix/nix.conf
export NIX_CONFIG="experimental-features = nix-command flakes"

# User-installed packages go in a separate nix profile (persisted in /nix/var volume)
DEBUX_PROFILE="/nix/var/debux-profile"
NIXPKGS_REF="${NIXPKGS_REF:-nixpkgs}"

ensure_home() {
  if [[ -z "${HOME:-}" || ! -d "$HOME" || ! -w "$HOME" || ! -O "$HOME" ]]; then
    local uid
    uid="$(id -u 2>/dev/null || echo 0)"
    export HOME="/tmp/debux-home-$uid"
    mkdir -p "$HOME"
  fi
}

ensure_nix_writable() {
  if [[ $EUID -eq 0 ]]; then
    return 0
  fi
  if [[ -w /nix/store && -w /nix/var && -w /nix/var/nix/db ]]; then
    return 0
  fi

  cat >&2 <<'EOF'

This debug container is running as non-root, but the Nix store is not writable.

To install tools with dctl under --profile=restricted, rebuild and push the
current debux debug image, then start a fresh session:

  mise run image-build
  docker push ghcr.io/clement-tourriere/debux:latest
  debux k8s://... --profile=restricted --fresh --pull-policy=Always

Alternatively, use --profile=general for a root debug container.
EOF
  return 1
}

ensure_home

# Command-to-nixpkgs mapping for common mismatches
declare -A ALIASES=(
  [nvim]=neovim
  [python]=python3
  [node]=nodejs
  [npm]=nodejs
  [npx]=nodejs
  [cc]=gcc
  [c++]=gcc
  [g++]=gcc
  [make]=gnumake
  [ip]=iproute2
  [ss]=iproute2
  [netstat]=nettools
  [ifconfig]=nettools
  [ping]=inetutils
  [telnet]=inetutils
  [nc]=nmap
  [ncat]=nmap
  [cargo]=rustc
  [pgrep]=procps
  [pkill]=procps
  [free]=procps
  [watch]=procps
  [xargs]=findutils
  [locate]=findutils
  [sed]=gnused
  [awk]=gawk
  [diff]=diffutils
  [tar]=gnutar
  [unzip]=unzip
  [zip]=zip
  [ag]=silver-searcher
  [rg]=ripgrep
  [fd]=fd
  [bat]=bat
  [tmux]=tmux
  [http]=httpie
  [https]=httpie
  [delta]=delta
  [lazygit]=lazygit
  [k9s]=k9s
  [stern]=stern
  [kubectx]=kubectx
  [kustomize]=kustomize
)

resolve_pkg() {
  local pkg="$1"
  if [[ -n "${ALIASES[$pkg]+x}" ]]; then
    echo "${ALIASES[$pkg]}"
  else
    echo "$pkg"
  fi
}

case "${1:-}" in
  install)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: dctl install <pkg> [pkg...]" >&2
      exit 2
    fi

    ensure_nix_writable || exit 1

    status=0
    for pkg in "$@"; do
      resolved=$(resolve_pkg "$pkg")
      if [[ "$resolved" != "$pkg" ]]; then
        echo -e "\e[36m$pkg\e[0m → \e[32m$resolved\e[0m"
      fi
      echo "Installing $resolved..."
      if nix profile add --profile "$DEBUX_PROFILE" "$NIXPKGS_REF#$resolved"; then
        echo -e "\e[32mInstalled $resolved.\e[0m"
      else
        status=1
        echo ""
        echo -e "  \e[31mFailed to install '$resolved'.\e[0m"
        echo "  It may not exist in nixpkgs, or it may currently fail to build."
        echo "  Try: dctl search $pkg"
      fi
    done
    exit "$status"
    ;;
  remove)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: dctl remove <pkg> [pkg...]" >&2
      exit 2
    fi
    ensure_nix_writable || exit 1
    for pkg in "$@"; do
      resolved=$(resolve_pkg "$pkg")
      # Use --json to reliably check if the element exists (avoids ANSI / whitespace issues)
      if nix profile list --profile "$DEBUX_PROFILE" --json 2>/dev/null | jq -e --arg pkg "$resolved" '.elements[$pkg]' >/dev/null 2>&1; then
        nix profile remove --profile "$DEBUX_PROFILE" "$resolved"
        echo -e "\e[32mRemoved $resolved.\e[0m"
      else
        echo "Package '$resolved' not found in profile."
      fi
    done
    ;;
  search)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: dctl search <query>" >&2
      exit 2
    fi
    nix search "$NIXPKGS_REF" "$1" 2>/dev/null || echo "Search failed. Try: nix search $NIXPKGS_REF $1"
    ;;
  list)
    echo "Base packages (from image):"
    nix-env -q 2>/dev/null || true
    echo ""
    echo "User-installed packages:"
    nix profile list --profile "$DEBUX_PROFILE" 2>/dev/null || echo "  (none)"
    ;;
  update)
    ensure_nix_writable || exit 1
    nix flake metadata --refresh "$NIXPKGS_REF" >/dev/null
    echo -e "\e[32mRefreshed nixpkgs flake metadata.\e[0m"
    ;;
  *)
    echo "dctl - debux package manager"
    echo ""
    echo "Usage:"
    echo "  dctl install <pkg> [pkg...]   Install packages from nixpkgs"
    echo "  dctl remove <pkg> [pkg...]    Remove installed packages"
    echo "  dctl search <query>           Search available packages"
    echo "  dctl list                     List installed packages"
    echo "  dctl update                   Update package index"
    ;;
esac
